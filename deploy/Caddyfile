# 尘起时刻 · 联机版 · Caddy 配置（路线乙的备选，二选一）
#
# 适用：不想装/不想配 nginx，用 Caddy —— 自动申请并续期证书，一个文件搞定。
#
# 用法：
#   1. 安装 Caddy（Debian/Ubuntu）：
#        sudo apt install -y debian-keyring debian-archive-keyring apt-transport-https curl
#        curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
#        curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-stable.list
#        sudo apt update && sudo apt install -y caddy
#      （CentOS/RHEL 用官方 COPR：dnf install 'dnf-command(copr)' && dnf copr enable @caddy/caddy && dnf install caddy）
#   2. 把 example.com 换成你的域名，把本文件内容放进 /etc/caddy/Caddyfile
#   3. sudo systemctl reload caddy      （首次会自动申请证书）
#
# 前提：域名已解析到本机；80/443 放行。

example.com {
	root * /opt/dust/www
	encode gzip zstd

	# 联机中继（Caddy 会自动处理 WebSocket 升级）
	@ws path /ws*
	reverse_proxy @ws 127.0.0.1:8787

	file_server

	# 首页不缓存
	@html path /index.html
	header @html Cache-Control "no-store"

	# 带 hash 的静态资源长缓存
	@assets path /assets/*
	header @assets Cache-Control "public, immutable"
}
